VOICESTUDIO_URL=http://localhost:8001
RAG_ENGINE=stub               # stub | weknora
WEKNORA_URL=http://localhost:8002
MEMORY_ENGINE=stub            # stub | hindsight
HINDSIGHT_URL=http://localhost:8003
DATABASE_URL=                 # ej. postgresql://... (prod, pgvector)
