# Copiar a .env y rellenar. En sandbox todo funciona con los stubs (valores vacíos).
CONTESTA_DB=contesta.db

# Real (piloto): trunk SIP español, agenda, WhatsApp
SIP_PROVIDER_URL=
SIP_TRUNK_USER=
SIP_TRUNK_PASSWORD=
SIP_FALLBACK_MOBILE=+34XXXXXXXXX
AGENDA_PROVIDER=google        # google | calcom
GOOGLE_CALENDAR_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
